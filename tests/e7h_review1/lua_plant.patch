+      memset(v[i], 1, 1 << 20);
+      plant_sink = v[i];
+      if (i % 64 == 63) plant_spin_for(0.06);
+    }
+    for (int i = 0; i < 6144; i++) free(v[i]);
+    free(v);
+  }
+}
