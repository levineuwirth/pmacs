#!/bin/sh
# scripts/build-parse-unit-wasm --- build the parse unit as a wasm module
# (E7i's whole-runtime-in-wasm candidate).
#
#   WASI_SDK_PATH=/path/to/wasi-sdk-29.0-x86_64-linux scripts/build-parse-unit-wasm [--profile release]
#
# Builds `pmacs-parse-unit` for `wasm32-wasip1`: the tree-sitter runtime,
# every grammar in `BUILTIN_LANGUAGES` and the unit's own code, all in one
# module, the C compiled by wasi-sdk's clang with `-fno-strict-aliasing`
# (`.cargo/config.toml` passes it through `TARGET_CFLAGS`). The module is
# copied beside the native binaries as `pmacs-parse-unit.wasm`, where an
# editor built with `--features wasm-unit` looks for it when
# `syntax.isolation` is `"wasm"`.
#
# Needs: `rustup target add wasm32-wasip1` for the pinned toolchain, and
# wasi-sdk 29.0 (the version tree-sitter-loader 0.26.8 pins in its
# `wasi-sdk-version`). This is the comparison's build, not a release
# build: pinning and provisioning for offline builds is E7i.2's, if the
# owner rules for wasm.
set -eu

profile=release
while [ $# -gt 0 ]; do
    case "$1" in
        --profile) profile=$2; shift 2 ;;
        *) echo "build-parse-unit-wasm: unknown argument: $1" >&2; exit 2 ;;
    esac
done

: "${WASI_SDK_PATH:?set WASI_SDK_PATH to a wasi-sdk 29.0 directory}"
[ -x "$WASI_SDK_PATH/bin/clang" ] || { echo "build-parse-unit-wasm: no clang in $WASI_SDK_PATH/bin" >&2; exit 2; }

root=$(cd "$(dirname "$0")/.." && pwd)
target_dir=${CARGO_TARGET_DIR:-$root/target}

export CC_wasm32_wasip1="$WASI_SDK_PATH/bin/clang"
export AR_wasm32_wasip1="$WASI_SDK_PATH/bin/llvm-ar"
export CFLAGS_wasm32_wasip1="--sysroot=$WASI_SDK_PATH/share/wasi-sysroot"

cd "$root"
cargo build -p pmacs-parse-unit --target wasm32-wasip1 --profile "$profile"

case "$profile" in
    dev) out=debug ;;
    *) out=$profile ;;
esac
module="$target_dir/wasm32-wasip1/$out/pmacs-parse-unit.wasm"
cp "$module" "$target_dir/$out/pmacs-parse-unit.wasm"
echo "build-parse-unit-wasm: $target_dir/$out/pmacs-parse-unit.wasm ($(wc -c < "$module") bytes)"
