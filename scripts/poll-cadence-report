#!/usr/bin/env python3
"""MEASUREMENT INSTRUMENT (#259, #266), not for merge.

Summarize poll-cadence.tsv, the per-wait timing file tests/common/ready.rs
appends to under this instrument, as distributions rather than a verdict.

Usage: scripts/poll-cadence-report [poll-cadence.tsv] [test-log]

Columns (tab-separated, one line per completed wait):
  0 POLL-CADENCE  1 loop (wait_with|tick_until)  2 what  3 poll_ms
  4 deadline_ms  5 polls  6 elapsed_ms  7 step_ms  8 probe_ms
  9 probe_max_ms  10 probe_first_ms  11 sleeps  12 sleep_asked_ms
  13 sleep_got_ms  14 sleep_over_max_ms  15 outcome
"""
import re
import sys
from collections import defaultdict

path = sys.argv[1] if len(sys.argv) > 1 else "poll-cadence.tsv"
log = sys.argv[2] if len(sys.argv) > 2 else None

rows = []
try:
    with open(path, encoding="utf-8", errors="replace") as fh:
        for line in fh:
            f = line.rstrip("\n").split("\t")
            if len(f) != 16 or f[0] != "POLL-CADENCE":
                continue
            try:
                rows.append({
                    "loop": f[1], "what": f[2], "poll": float(f[3]),
                    "deadline": float(f[4]), "polls": int(f[5]),
                    "elapsed": float(f[6]), "step": float(f[7]),
                    "probe": float(f[8]), "probe_max": float(f[9]),
                    "probe_first": float(f[10]), "sleeps": int(f[11]),
                    "sleep_asked": float(f[12]), "sleep_got": float(f[13]),
                    "sleep_over_max": float(f[14]), "outcome": f[15],
                })
            except ValueError:
                continue
except FileNotFoundError:
    print(f"POLL-CADENCE REPORT: no samples ({path} absent)")
    sys.exit(0)


def q(xs, p):
    if not xs:
        return float("nan")
    xs = sorted(xs)
    return xs[min(len(xs) - 1, int(round((len(xs) - 1) * p)))]


def dist(xs):
    if not xs:
        return "n=0"
    return (f"n={len(xs)} min={min(xs):.2f} p50={q(xs, .5):.2f} "
            f"p90={q(xs, .9):.2f} p99={q(xs, .99):.2f} max={max(xs):.2f}")


def site(what):
    # Collapse paths and numbers so the same wait at different fixtures
    # groups together.
    w = re.sub(r"\S*/\S*", "<path>", what)
    w = re.sub(r"\d+", "#", w)
    return w[:90]


print(f"POLL-CADENCE REPORT: {len(rows)} waits from {path}")
if log:
    try:
        text = open(log, encoding="utf-8", errors="replace").read()
        running = len(re.findall(r"^\s*Running ", text, re.M))
        results = len(re.findall(r"^test result: ", text, re.M))
        failed = len(re.findall(r"^test result: FAILED", text, re.M))
        print(f"test log: {running} targets started, {results} result lines, {failed} FAILED")
    except FileNotFoundError:
        print(f"test log: {log} absent")

for loop in ("wait_with", "tick_until"):
    sub = [r for r in rows if r["loop"] == loop]
    print(f"\n== {loop}: {len(sub)} waits; "
          f"{sum(1 for r in sub if r['outcome'] == 'timeout')} timed out; "
          f"{sum(1 for r in sub if r['polls'] == 1)} ready at the first probe")
    if not sub:
        continue
    by_poll = defaultdict(list)
    for r in sub:
        by_poll[r["poll"]].append(r)
    for poll, rs in sorted(by_poll.items()):
        multi = [r for r in rs if r["polls"] >= 2]
        print(f"\n-- requested poll {poll:.1f} ms: {len(rs)} waits, {len(multi)} with >= 2 polls")
        if not multi:
            continue
        cadence = [r["elapsed"] / r["polls"] for r in multi]
        sleep_mean = [r["sleep_got"] / r["sleeps"] for r in multi if r["sleeps"]]
        over_mean = [(r["sleep_got"] - r["sleep_asked"]) / r["sleeps"] for r in multi if r["sleeps"]]
        over_max = [r["sleep_over_max"] for r in multi if r["sleeps"]]
        probe_mean = [r["probe"] / r["polls"] for r in multi]
        probe_max = [r["probe_max"] for r in multi]
        step_mean = [r["step"] / r["polls"] for r in multi]
        print(f"   ms per iteration (elapsed/polls, #259's figure): {dist(cadence)}")
        print(f"   mean actual sleep per call              : {dist(sleep_mean)}")
        print(f"   mean sleep overshoot per call           : {dist(over_mean)}")
        print(f"   max sleep overshoot within a wait       : {dist(over_max)}")
        print(f"   mean probe cost per call                : {dist(probe_mean)}")
        print(f"   max probe cost within a wait            : {dist(probe_max)}")
        print(f"   mean step cost per call                 : {dist(step_mean)}")
        slow = sum(1 for c in cadence if c > 2 * poll)
        print(f"   waits whose cadence exceeds 2x the requested poll: {slow} of {len(multi)}")
        # Where does an iteration's time go, summed over these waits?
        tot_el = sum(r["elapsed"] for r in multi)
        tot_sl = sum(r["sleep_got"] for r in multi)
        tot_ask = sum(r["sleep_asked"] for r in multi)
        tot_pr = sum(r["probe"] for r in multi)
        tot_st = sum(r["step"] for r in multi)
        if tot_el:
            print(f"   share of elapsed: asked sleep {100*tot_ask/tot_el:.1f}%  "
                  f"sleep overshoot {100*(tot_sl-tot_ask)/tot_el:.1f}%  probe {100*tot_pr/tot_el:.1f}%  "
                  f"step {100*tot_st/tot_el:.1f}%  other {100*(tot_el-tot_sl-tot_pr-tot_st)/tot_el:.1f}%")
    first = [r["probe_first"] for r in sub]
    print(f"\n   first probe cost (all {loop} waits)      : {dist(first)}")
    print(f"   first probe >= 60 ms (#266's shape)      : {sum(1 for x in first if x >= 60)} of {len(first)}")
    gap = [r["elapsed"] for r in sub if r["polls"] == 1]
    print(f"   elapsed of one-poll waits                : {dist(gap)}")

    # Sites, by median cadence, multi-poll waits only.
    by_site = defaultdict(list)
    for r in sub:
        if r["polls"] >= 2:
            by_site[site(r["what"])].append(r)
    ranked = sorted(by_site.items(), key=lambda kv: -q([x["elapsed"] / x["polls"] for x in kv[1]], .5))
    print(f"\n   top sites by median ms/iteration (>= 2 polls):")
    for name, rs in ranked[:12]:
        cad = [x["elapsed"] / x["polls"] for x in rs]
        pm = [x["probe"] / x["polls"] for x in rs]
        so = [(x["sleep_got"] - x["sleep_asked"]) / x["sleeps"] for x in rs if x["sleeps"]]
        print(f"     {name!r}: n={len(rs)} cadence p50={q(cad,.5):.1f} max={max(cad):.1f} "
              f"| probe p50={q(pm,.5):.2f} | sleep overshoot p50={q(so,.5):.2f}")

# The specific waits the rows are about.
print("\n== named waits")
for label, pat in (("#259 (bytes in .../ready)", r"^bytes in .*ready$"),
                   ("wait_for_daemon", r"^a daemon listening on ")):
    rs = [r for r in rows if re.search(pat, r["what"])]
    if not rs:
        print(f"   {label}: none recorded")
        continue
    cad = [r["elapsed"] / r["polls"] for r in rs if r["polls"] >= 2]
    print(f"   {label}: n={len(rs)}, timeouts={sum(1 for r in rs if r['outcome']=='timeout')}, "
          f"polls {dist([float(r['polls']) for r in rs])}")
    print(f"      cadence ms/iter: {dist(cad)}")
    print(f"      probe max ms   : {dist([r['probe_max'] for r in rs])}")
    print(f"      sleep over max : {dist([r['sleep_over_max'] for r in rs])}")
