#!/bin/sh
# scripts/fuzz-grammars --- fuzz every bundled tree-sitter grammar the
# way it ships (E7g).
#
#   scripts/fuzz-grammars [--seconds N] [--jobs N] [--grammar NAME]...
#                         [--from [LABEL=]DIR]... [--max-files N]
#                         [--max-seed-kb N] [--min-mutations N]
#                         [--max-seconds N] [--long-since REF]
#                         [--long-seconds N] [--out DIR] [--plain]
#
# The grammars are C beside a `#![forbid(unsafe_code)]` editor, and in
# daemon mode one bad parse takes every buffer the daemon holds. E7e
# shipped tree-sitter-haskell 0.23.1 because its author's test file
# parsed; the owner's real file, two `{-# LANGUAGE #-}` pragmas, aborted
# the editor within minutes. So a grammar ships only after this has run
# over it, and CI runs it (.github/workflows/grammar-fuzz.yml) whenever
# the grammar set can have changed.
#
# What it does:
#
#   1. Builds src/bin/pmacs_grammar_fuzz.rs under the `fuzz` profile,
#      which inherits `release`: the C is compiled at -O3 as it ships,
#      with the -fno-strict-aliasing .cargo/config.toml adds to every C
#      compile (E7h.1). That is not a detail: the Haskell overflow was
#      undefined behavior GCC 16 exploits at -O2 and above, and a debug
#      build is clean. The tree-sitter runtime and every grammar's C are
#      instrumented with AddressSanitizer and UndefinedBehaviorSanitizer
#      (E7h.4: UB is reported where it happens, not when a compiler turns
#      it into a crash) through a compiler wrapper that recognizes a
#      grammar by the package it builds, not by its path, and the build
#      fails if any grammar's C went uninstrumented (--plain builds them
#      uninstrumented, byte for byte as released).
#   2. Fetches each grammar's own real sources at the commit
#      fuzz/corpora.tsv pins: its upstream test corpus, or real files
#      where it ships none.
#   3. Collects seeds from those, from this tree, and from each --from
#      directory (a git repository contributes its tracked files only),
#      at most --max-files per grammar from each source (default 400; the
#      PR smoke takes 100, since Zig's standard library alone is otherwise
#      twenty minutes of seeds).
#   4. Runs the harness: every seed, then mutations until --seconds pass
#      and at least --min-mutations were made (under --max-seconds), per
#      grammar, --jobs grammars at a time, and writes report.md and
#      report.tsv with a minimized reproduction per finding. With
#      --long-since REF, the grammars the change since REF touched (a
#      crate's locked version, its corpora row, its vendored copy) run for
#      --long-seconds (default 600) instead; a tree-sitter runtime bump
#      runs every grammar long.
#
# Exit status is the harness's: 0 no finding, 1 findings, 2 setup
# (including a grammar with no seeds). The build directory is the
# gate's per-worktree target with `-fuzz` appended, never the shared
# CARGO_TARGET_DIR, so the release pair there is never rebuilt; set
# PMACS_FUZZ_DIR to put it elsewhere.
set -eu

die() { echo "fuzz-grammars: $*" >&2; exit 2; }

seconds=60
jobs=4
max_files=400
max_seed_kb=64
min_mutations=0
max_seconds=0
long_since=
long_seconds=600
plain=0
out=
grammars=
froms=
while [ $# -gt 0 ]; do
    case "$1" in
        --seconds) seconds=${2:?}; shift 2 ;;
        --jobs) jobs=${2:?}; shift 2 ;;
        --grammar) grammars="$grammars --grammar ${2:?}"; shift 2 ;;
        --from) froms="$froms --from ${2:?}"; shift 2 ;;
        --max-files) max_files=${2:?}; shift 2 ;;
        --max-seed-kb) max_seed_kb=${2:?}; shift 2 ;;
        --min-mutations) min_mutations=${2:?}; shift 2 ;;
        --max-seconds) max_seconds=${2:?}; shift 2 ;;
        --long-since) long_since=${2:?}; shift 2 ;;
        --long-seconds) long_seconds=${2:?}; shift 2 ;;
        --out) out=${2:?}; shift 2 ;;
        --plain) plain=1; shift ;;
        -h|--help) sed -n '2,40p' "$0"; exit 0 ;;
        *) die "unknown argument: $1" ;;
    esac
done

root=$(git rev-parse --show-toplevel) || die "not inside a git worktree"
cd "$root"
work=${PMACS_FUZZ_DIR:-$(scripts/gate --print-target-dir)-fuzz}
mkdir -p "$work"
work=$(cd "$work" && pwd)
[ -n "$out" ] || out="$work/report-$(date -u +%Y%m%dT%H%M%SZ)"
mkdir -p "$out"
out=$(cd "$out" && pwd)

# --- 1. build -----------------------------------------------------------
host=$(rustc -vV | sed -n 's/^host: //p')
export CARGO_TARGET_DIR="$work/target"
# sccache would key the instrumented objects on the wrapper, not on the
# flag the wrapper adds; build without it.
export RUSTC_WRAPPER=
unset RUSTFLAGS
preload=
# The crates whose C is a grammar or the runtime: fuzz/corpora.tsv's crate
# column, and tree-sitter itself.
grammar_crates=$(awk -F '\t' '!/^#/ && NF >= 2 && $1 != "grammar" { print $2 }' fuzz/corpora.tsv | sort -u | tr '\n' ' ')
grammar_crates="tree-sitter $grammar_crates"
if [ "$plain" = 0 ]; then
    real_cc=${CC:-cc}
    libasan=$("$real_cc" -print-file-name=libasan.so)
    libubsan=$("$real_cc" -print-file-name=libubsan.so)
    [ -f "$libasan" ] || die "no libasan.so beside $real_cc (install the compiler's sanitizer runtime, or pass --plain)"
    [ -f "$libubsan" ] || die "no libubsan.so beside $real_cc (install the compiler's sanitizer runtime, or pass --plain)"
    # E7h.4: it instruments by the package being built (cargo sets
    # CARGO_PKG_NAME for the build script that runs cc), not by a path a
    # crate's name happens to match, and records each package it did. It
    # is named by a checksum of itself: cc recompiles only when CC's value
    # changes, so a wrapper edited in place would leave objects the old one
    # built.
    : >> "$work/instrumented.log"
    wrapper="$work/sanitize-cc.tmp"
    cat > "$wrapper" <<EOF
#!/bin/sh
case " $grammar_crates " in
    *" \${CARGO_PKG_NAME:-} "*)
        echo "\$CARGO_PKG_NAME" >> "$work/instrumented.log"
        exec "$real_cc" "\$@" -fsanitize=address,undefined -fno-sanitize-recover=undefined -fno-omit-frame-pointer ;;
esac
exec "$real_cc" "\$@"
EOF
    sum=$(cksum < "$wrapper" | cut -d' ' -f1)
    mv "$wrapper" "$work/sanitize-cc-$sum"
    wrapper="$work/sanitize-cc-$sum"
    chmod +x "$wrapper"
    export CC="$wrapper"
    # --target keeps these off build scripts, which run uninstrumented.
    export RUSTFLAGS="-C link-arg=-Wl,--no-as-needed -C link-arg=$libasan -C link-arg=$libubsan"
    preload=$libasan
    export ASAN_OPTIONS="detect_leaks=0:abort_on_error=1:allocator_may_return_null=1:detect_stack_use_after_return=0"
    export UBSAN_OPTIONS="halt_on_error=1:abort_on_error=1:print_stacktrace=1"
fi
cargo build --profile fuzz --target "$host" --bin pmacs_grammar_fuzz
if [ "$plain" = 0 ]; then
    # The proof is what the `cc` crate recorded in each grammar crate's
    # build-script output: the compiler it ran, this wrapper, whose name
    # carries its checksum. That record is cached with the objects it
    # built; the wrapper's own log is not, and a restored cache recompiles
    # nothing (PR #297's second CI run failed on exactly that).
    build="$CARGO_TARGET_DIR/$host/fuzz/build"
    for c in $grammar_crates; do
        found=
        for o in "$build/$c"-*/output; do
            [ -f "$o" ] || continue
            hash=${o%/output}
            hash=${hash##*/"$c"-}
            case "$hash" in *[!0-9a-f]* | '') continue ;; esac
            grep -qxF "CC = Some($wrapper)" "$o" && found=1
        done
        [ -n "$found" ] \
            || die "$c's C was not compiled under the sanitizers (no build record under $build names $wrapper)"
    done
fi
bin="$CARGO_TARGET_DIR/$host/fuzz/pmacs_grammar_fuzz"
fuzz() { LD_PRELOAD="$preload" "$bin" "$@"; }

# --- 2. upstream sources ---------------------------------------------------
registry=${CARGO_HOME:-$HOME/.cargo}/registry/src
corpora=
tab=$(printf '\t')
while IFS="$tab" read -r grammar crate version repo commit kind paths; do
    case "$grammar" in ''|'#'*|grammar) continue ;; esac
    if [ "$kind" = crate ]; then
        dir=$(ls -d "$registry"/*/"$crate-$version" 2>/dev/null | head -n 1)
        [ -n "$dir" ] || die "$crate $version is not in $registry (cargo fetch)"
    else
        # One checkout per row: rows sharing a repository want different paths.
        dir="$work/upstream/$grammar-$commit"
        if [ ! -d "$dir/.done" ]; then
            rm -rf "$dir"
            git init -q "$dir"
            git -C "$dir" remote add origin "$repo"
            git -C "$dir" sparse-checkout set --no-cone $(echo "$paths" | tr ',' ' ')
            git -C "$dir" fetch -q --depth 1 --filter=blob:none origin "$commit"
            git -C "$dir" checkout -q FETCH_HEAD
            mkdir "$dir/.done"
        fi
        [ "$(git -C "$dir" rev-parse HEAD)" = "$commit" ] || die "$dir is not at $commit"
    fi
    for p in $(echo "$paths" | tr ',' ' '); do
        [ -e "$dir/$p" ] || die "$grammar: $dir/$p is missing"
        case "$kind" in
            corpus) corpora="$corpora --corpus $grammar=$dir/$p" ;;
            *) froms="$froms --from upstream-$grammar=$dir/$p" ;;
        esac
    done
done < fuzz/corpora.tsv

# --- 3. seeds ------------------------------------------------------------
rm -rf "$work/corpus"
# shellcheck disable=SC2086
fuzz collect --out "$work/corpus" --max-files "$max_files" --max-seed-kb "$max_seed_kb" --from "pmacs=$root" $froms $corpora
cp "$work/corpus/MANIFEST.tsv" "$out/seeds.tsv"

# --- 4. run --------------------------------------------------------------
longs=
if [ -n "$long_since" ]; then
    changed=$(fuzz changed --since "$long_since") || die "cannot tell what changed since $long_since"
    if [ "$changed" = "*" ]; then
        echo "fuzz-grammars: the tree-sitter runtime moved since $long_since; every grammar runs $long_seconds s" >&2
        seconds=$long_seconds
    else
        for g in $changed; do longs="$longs --long $g"; done
        echo "fuzz-grammars: changed since $long_since, run $long_seconds s:${changed:+ }$(echo $changed)" >&2
    fi
fi
echo "fuzz-grammars: $seconds s and at least $min_mutations mutations per grammar, $jobs at a time, report in $out" >&2
set +e
# shellcheck disable=SC2086
fuzz run --corpus "$work/corpus" --out "$out" --seconds "$seconds" --jobs "$jobs" \
    --min-mutations "$min_mutations" --max-seconds "$max_seconds" \
    --long-seconds "$long_seconds" $longs $grammars
status=$?
set -e
cat "$out/report.md"
exit "$status"
